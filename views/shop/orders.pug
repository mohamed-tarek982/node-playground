extends ../layouts/mian-layout.pug

block content
  main.container
    h1 #{pageTitle}
    if orders.length > 0
      each order in orders
        section.order
          h2 Order ##{order._id} - #{order.createdAt.toLocaleString()}
          ul
            each product in order.products
              li #{product.title} (#{product.quantity} x $#{product.price})
          p
            strong Total: $#{order.total.toFixed(2)}
    else
      p You have no orders yet.
