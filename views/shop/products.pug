extends ../layouts/mian-layout.pug

block content
  main.container
    //- Dynamic Data Rendering
    h1 #{pageTitle}
    if products.length > 0
      section.products
        each product in products
          article.card
            if product.imageUrl
              img(src=product.imageUrl alt=product.title)
            .card-body
              h2= product.title
              if product.price !== undefined
                p.price $#{product.price}
              if product.description
                p= product.description
              .card-actions
                form(action="/shop/cart" method="POST")
                  input(type="hidden" name="productId" value=product.id)
                  button.btn.btn-primary(type="submit") Add to Cart
                a.btn.btn-outline(href=`/shop/product-details/${product.id}`) Details
                a.btn.btn-outline(href=`/admin/edit-product/${product.id}`) Edit
                form(action=`/admin/delete-product/${product.id}` method="POST" onsubmit="return confirm('Delete this product?')")
                  button.btn.btn-danger(type="submit") Delete
    else
      p No products found.


