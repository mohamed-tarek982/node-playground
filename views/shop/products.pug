extends ../layouts/mian-layout.pug

block content
  main.container
    //- Dynamic Data Rendering
    h1 #{pageTitle}
    if products.length > 0
      section.products
        each product in products
          article.card
            if product.imageUrl
              img(src=product.imageUrl alt=product.title)
            .card-body
              h2= product.title
              if product.price !== undefined
                p.price $#{product.price}
              if product.description
                p= product.description
              a.btn(href=`/shop/product-details/${product.id}`) Details
              a.btn(href=`/admin/edit-product/${product.id}`) Edit
              form(action=`/admin/delete-product/${product.id}` method="POST" style="display:inline" onsubmit="return confirm('Delete this product?')")
                button.btn(type="submit") Delete
    else
      p No products found.


