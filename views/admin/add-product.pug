extends ../layouts/mian-layout.pug

block styles
  link(rel="stylesheet" href="/css/add-product.css")

block content
  - const p = product || {}
  main.container
    h1 #{pageTitle}
    form.product-form(action=product ? `/admin/edit-product/${product.id}` : "/admin/add-product" method="POST")
      .form-group
        label(for="productName") Product Name
        input#productName(type="text" name="productName" placeholder="Enter product name" value=p.title required)
      .form-group
        label(for="price") Price
        input#price(type="number" name="price" step="0.01" min="0" placeholder="Enter price" value=p.price required)
      .form-group
        label(for="imageUrl") Image URL
        input#imageUrl(type="url" name="imageUrl" placeholder="Enter image URL" value=p.imageUrl required)
      .form-group
        label(for="description") Description
        textarea#description(name="description" rows="4" placeholder="Enter description" required)= p.description
      button(type="submit")= product ? "Update Product" : "Add Product"
